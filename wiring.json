{
 "artifacts": {
  "PRs into each repo in `.github/consumers.txt`": {
   "match": "",
   "pin": [],
   "pub": [
    "marola-devkit `bump-consumers.yml`",
    "marola-devkit `bump-merge.yml` (on a schedule)"
   ],
   "read": [
    "marola",
    "marola-app",
    "marola-site",
    "marola-ml",
    "marola-corpus",
    "marola-oods",
    "marola-skills"
   ],
   "repos": [
    "marola-devkit"
   ]
  },
  "PRs into marola-app: `recommendation_prompt.json`, `review_prompt.json`": {
   "match": "",
   "pin": [],
   "pub": [
    "marola-ml `compile-prompt.yml` (by hand)"
   ],
   "read": [
    "marola-app"
   ],
   "repos": [
    "marola-app"
   ]
  },
  "`<tag>-v<tag>.pdf` release asset": {
   "match": "",
   "pin": [],
   "pub": [
    "marola-research `release.yml` (on a `*-v[0-9]*.[0-9]*.[0-9]*` tag)"
   ],
   "read": [],
   "repos": [
    "marola-research"
   ]
  },
  "`api-docs` branch": {
   "match": "api-docs",
   "pin": [],
   "pub": [
    "marola-ml `ci.yml` (`api-docs.yml@v0.20.4`, on a push to `main`)",
    "marola-app `ci.yml` (`api-docs.yml@v0.20.4`, on a push to `main`)"
   ],
   "read": [
    "marola `scripts/fetch-api-docs.sh`"
   ],
   "repos": [
    "marola-app",
    "marola-ml"
   ]
  },
  "`ghcr.io/marola-dev/marola-app` image": {
   "match": "ghcr.io/marola-dev/marola-app",
   "pin": [
    "marola-site `marola-image`",
    "marola-ml `marola-image`",
    "marola-oods `marola-image`"
   ],
   "pub": [
    "marola-app `ci.yml` (on a push to `main`)"
   ],
   "read": [
    "marola-site `scripts/board-schema.sh`",
    "marola-ml `scripts/app-image.sh`",
    "marola-app `docker-compose.yml`",
    "marola-oods `scripts/app-image.sh`"
   ],
   "repos": [
    "marola-app"
   ]
  },
  "`ghcr.io/marola-dev/marola-ml` image": {
   "match": "ghcr.io/marola-dev/marola-ml",
   "pin": [],
   "pub": [
    "marola-ml `docker-local.yml` (on a push to `main` touching 10 paths)"
   ],
   "read": [
    "marola-app `docker-compose.yml`"
   ],
   "repos": [
    "marola-ml"
   ]
  },
  "`marola-corpus-<tag>.tar.gz` release asset": {
   "match": "",
   "pin": [
    "marola-ml `corpus.version`",
    "marola-app `corpus.version`"
   ],
   "pub": [
    "marola-corpus `release.yml` (on a `v*` tag)"
   ],
   "read": [
    "marola-ml `scripts/corpus-fetch.sh`",
    "marola-app `build.sbt`",
    "marola-app `scripts/corpus-fetch.sh`"
   ],
   "repos": [
    "marola-corpus"
   ]
  },
  "`ml-resources-<tag>.tar.gz` release asset": {
   "match": "",
   "pin": [
    "marola-ml `resources.version`"
   ],
   "pub": [
    "marola-app `release.yml` (on a `v*` tag)"
   ],
   "read": [
    "marola-ml `scripts/resources-fetch.sh`"
   ],
   "repos": [
    "marola-app"
   ]
  },
  "`site-data` branch of marola-site": {
   "match": "site-data",
   "pin": [],
   "pub": [
    "marola `ci.yml` (on a push to `main`)",
    "marola-app `ci.yml` (on a push to `main`)",
    "marola-app `docker-smoke.yml` (on a schedule)"
   ],
   "read": [
    "marola-site `site.yml`"
   ],
   "repos": [
    "marola-site"
   ]
  }
 },
 "bumps": {
  "marola `flake.lock`": [
   "marola `ci.yml`",
   "marola `docs.yml`"
  ],
  "marola-app `corpus.version`": [
   "marola-app `ci.yml`"
  ],
  "marola-ml `marola-image`": [
   "marola-ml `docker-local.yml`"
  ],
  "marola-ml `resources.version`": [
   "marola-ml `docker-local.yml`"
  ],
  "marola-oods `marola-image`": [
   "marola-oods `oods-check.yml`"
  ],
  "marola-site `marola-image`": [
   "marola-site `board-schema.yml`",
   "marola-site `site.yml`"
  ]
 },
