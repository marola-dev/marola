#!/usr/bin/env bash
# marola-tools: the umbrella's repo tooling (tools/, Scala 3). scala-cli compiles it on first use
# and caches the build in tools/.scala-build; `scripts/marola-tools --help` lists the commands.
# Needs scala-cli and a JDK 21 (nix develop has both; CI installs them with coursier/setup-action).
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export MAROLA_ROOT="$root"
exec scala-cli run --quiet --main-class Main "$root/tools" -- "$@"
