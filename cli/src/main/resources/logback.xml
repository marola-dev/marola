<configuration>
  <!-- Every logger writes to stderr, never stdout: `SwimConditionsMcpServer` speaks MCP over
       stdio (MIP-0011 §5 item 9), and without this file Logback falls back to its built-in
       BasicConfigurator, which logs at DEBUG to System.out — confirmed live: it corrupted the
       MCP stdio transport with `reactor.util.Loggers`/`McpTransport` DEBUG lines before this
       file existed. `just run`/`just e2e` are unaffected — this only moves where logs land. -->
  <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.err</target>
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} -- %msg%n</pattern>
    </encoder>
  </appender>
  <root level="INFO">
    <appender-ref ref="STDERR" />
  </root>
</configuration>
