# marola-local — MIP-0008 §5.3: the fine-tuned model as a versioned artefact. Ollama with
# `marola-llama3.2` (finetune/Modelfile, Tier 1: llama3.2 + marola's persona and decoding
# settings, no weight change — finetune/README.md says so plainly) already in its model store, so
# `docker compose --profile local run --rm marola-local --summarize …` needs no pull and no
# `ollama create`. Built and pushed by docker-local.yml as ghcr.io/h0ffmann/marola:local-<sha>;
# the `:local` tag moves only after the benchmark gate (scripts/benchmark_gate.py) passes.
# ~2 GB for the llama3.2 weights + the variant's manifest. Tier 2 (the QLoRA adapter) is not in
# v1 (MIP-0008.tasks.md decision 5).
#
# Lint: `just quality` runs hadolint on this file too.
ARG OLLAMA_IMAGE=ollama/ollama:latest
FROM ${OLLAMA_IMAGE}

# The model store goes to a path of our own rather than /root/.ollama, so nothing depends on
# whether the base image declares that directory a volume (files written under a declared
# volume during a build are discarded).
ENV OLLAMA_MODELS=/models
COPY finetune/Modelfile /finetune/Modelfile

# `ollama pull`/`create` talk to a server: run one for the duration of this layer. Exactly what
# `just finetune-model` does on a laptop (finetune/README.md).
RUN (ollama serve > /tmp/ollama-build.log 2>&1 &) \
 && for _ in $(seq 1 60); do ollama list >/dev/null 2>&1 && break; sleep 1; done \
 && ollama pull llama3.2 \
 && ollama create marola-llama3.2 -f /finetune/Modelfile \
 && ollama list \
 && rm -f /tmp/ollama-build.log

EXPOSE 11434
HEALTHCHECK --interval=5s --timeout=5s --retries=12 CMD ollama list || exit 1
# ENTRYPOINT/CMD inherited: `ollama serve`.
