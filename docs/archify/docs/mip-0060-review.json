    {
      "id": "m5",
      "from": "Jail",
      "to": "Runner",
      "y": 379,
      "label": "ocr.json (comment text only)",
      "variant": "return"
    },
    {
      "id": "m6",
      "from": "Runner",
      "to": "Post",
      "y": 419,
      "label": "ocr.json"
    },
    {
      "id": "m7",
      "from": "Post",
      "to": "GH",
      "y": 459,
      "label": "one COMMENT review, upsert sticky summary"
