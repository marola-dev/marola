    {
      "id": "m4",
      "from": "Intake",
      "to": "Store",
      "y": 361,
      "label": "store Look (expiresAt = takenAt + 6h)"
    },
    {
      "id": "m5",
      "from": "Intake",
      "to": "User",
      "y": 401,
      "label": "reply",
      "variant": "return"
    },
    {
      "id": "m6",
      "from": "Intake",
      "to": "Sighting",
      "y": 467,
