{
  "schema_version": 2,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "MIP status, from Draft to Implemented, Rejected or Superseded",
    "locale": "en",
    "quality_profile": "standard",
    "legend": {
      "mode": "hidden"
    },
    "output": "dev-flow-mip-status.html"
  },
  "lanes": [
    {
      "id": "main",
      "label": "accepted"
    },
    {
      "id": "rej",
      "label": "rejected"
    },
    {
      "id": "sup",
      "label": "superseded"
    }
  ],
  "states": [
    {
      "id": "start",
      "type": "start",
      "label": "PR opened",
      "lane": "main",
      "col": 0
    },
    {
      "id": "Draft",
      "type": "waiting",
      "label": "Draft",
      "lane": "main",
      "col": 1
    },
    {
      "id": "Accepted",
      "type": "active",
      "label": "Accepted",
      "lane": "main",
      "col": 2
    },
    {
      "id": "Implemented",
      "type": "success",
      "label": "Implemented",
      "lane": "main",
      "col": 3
    },
    {
      "id": "Rejected",
      "type": "failure",
      "label": "Rejected",
      "lane": "rej",
      "col": 2
    },
    {
      "id": "Superseded",
      "type": "neutral",
      "label": "Superseded",
      "lane": "sup",
      "col": 2
    }
  ],
  "transitions": [
    {
      "id": "t1",
      "from": "start",
      "to": "Draft",
      "label": "own PR"
    },
    {
      "id": "t2",
      "from": "Draft",
      "to": "Accepted",
      "label": "decision"
    },
    {
      "id": "t3",
      "from": "Draft",
      "to": "Rejected",
      "label": "decision"
    },
    {
      "id": "t4",
      "from": "Draft",
      "to": "Superseded",
      "label": "by MIP-NNNN"
    },
    {
      "id": "t5",
      "from": "Accepted",
      "to": "Implemented",
      "label": "last merge"
    }
  ]
}
