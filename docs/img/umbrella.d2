# README.md's umbrella diagram; umbrella.pt-BR.d2 is its translation. `just diagrams` renders both.
vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
  }
}
direction: right

classes: {
  repo: {
    shape: rectangle
    style: {
      fill: "#ffffff"
      stroke: "#0b6e99"
      stroke-width: 2
      border-radius: 10
      font-color: "#0c2b3a"
      font-size: 17
      shadow: true
    }
  }
  contract: {
    style: {
      stroke: "#0b6e99"
      stroke-width: 2
      font-color: "#3d5a68"
      font-size: 16
    }
  }
  back: {
    style: {
      stroke: "#0b6e99"
      stroke-width: 2
      stroke-dash: 3
      font-color: "#3d5a68"
      font-size: 16
    }
  }
}

umbrella: "marola · the umbrella\nMIPs · phase list · docs.marola.dev · every repo as a submodule" {
  style: {
    fill: "#eef7fa"
    stroke: "#0b6e99"
    stroke-dash: 4
    border-radius: 16
    font-color: "#0b6e99"
    font-size: 22
    bold: true
  }

  corpus: "marola-corpus\nsourced ocean notes" {class: repo}
  app: "marola-app\nScala 3 + Kyo pipeline,\nscore, CLI, image" {class: repo; style.fill: "#d9eff7"}
  site: "marola-site\nthe map at marola.dev" {class: repo}
  ml: "marola-ml\nprompts, benchmark,\nmarola-sea" {class: repo}
  oods: "marola-oods\nopen ocean data lake\n(DuckLake on B2)" {class: repo}

  corpus -> app: "release tarball" {class: contract}
  corpus -> ml: "release tarball" {class: contract}
  app -> site: "image digest" {class: contract}
  app -> ml: "image + resources" {class: contract}
  ml -> app: "compiled prompts (PR)" {class: back}
  app -> oods: "ETL jobs write" {class: contract}
  oods -> app: "lake contract" {class: back}
}

devkit: "marola-devkit · tools, git hooks and reusable CI, pinned by tag in every repo" {
  near: bottom-center
  class: repo
  width: 760
  style: {
    fill: "#fff6e5"
    stroke: "#c07a00"
    font-color: "#5c3b00"
  }
}
