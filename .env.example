# Copy to .env for local development. Never commit the real .env.

# --- Storage / DB ---
DATABASE_URL=jdbc:postgresql://localhost:5432/nforganizer

# --- Cost governor (Phase 0 hard-coded defaults live in code; override here for local testing) ---
COST_GOVERNOR_MAX_REQUESTS_PER_USER_PER_DAY=20
COST_GOVERNOR_MAX_COST_CENTS_PER_USER_PER_DAY=200
COST_GOVERNOR_MAX_COST_CENTS_ACCOUNT_PER_DAY=5000

# --- Context7 MCP (.mcp.json, opencode.json) — optional; without a key the free tier is rate-limited ---
CONTEXT7_API_KEY=
