#!/usr/bin/env bash
# Blocks a commit if any staged Scala changes don't compile (the lint gates run in
# .githooks/pre-push).
set -euo pipefail

# See justfile's XDG_RUNTIME_DIR override: sbt's launcher needs a writable one to create its boot
# server socket, and ai-jail doesn't map /run/user into its sandbox, so a bare `sbt` here would
# die with `AccessDeniedException: /run/user` inside a jailed `just jail-claude` session.
repo_root="$(git rev-parse --show-toplevel)"
export XDG_RUNTIME_DIR="$repo_root/.tmp/sbt-runtime"
mkdir -p "$XDG_RUNTIME_DIR"

if git diff --cached --name-only --diff-filter=ACM | grep -qE '\.scala$'; then
  echo "pre-commit: staged Scala changes detected, running sbt Test/compile..."

  if [[ -n "${IN_NIX_SHELL:-}" ]] || ! command -v nix >/dev/null 2>&1; then
    sbt_cmd=(sbt)
  else
    sbt_cmd=(nix develop --command sbt)
  fi

  if ! "${sbt_cmd[@]}" Test/compile; then
    echo ""
    echo "pre-commit: sbt Test/compile failed — commit blocked." >&2
    echo "Fix the compile error, or bypass with 'git commit --no-verify' if you really need to." >&2
    exit 1
  fi
else
  echo "pre-commit: no staged .scala files, skipping sbt compile."
fi

# Same gate ci.yml's `quality` job runs, but at commit time — a broken workflow file used to
# surface only once GitHub Actions ran it.
if git diff --cached --name-only --diff-filter=ACM | grep -qE '^\.github/workflows/.*\.ya?ml$'; then
  if command -v actionlint >/dev/null 2>&1; then
    echo "pre-commit: staged workflow changes detected, running actionlint..."
    if ! actionlint; then
      echo ""
      echo "pre-commit: actionlint failed — commit blocked." >&2
      echo "Fix the workflow, or bypass with 'git commit --no-verify' if you really need to." >&2
      exit 1
    fi
  else
    echo "pre-commit: staged workflow changes detected but actionlint not installed — skipping (use 'nix develop')."
  fi
else
  echo "pre-commit: no staged workflow files, skipping actionlint."
fi
