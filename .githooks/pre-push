#!/usr/bin/env bash
# Blocks a push if the lint gates ci.yml runs would fail on it.
set -euo pipefail

remote="$1"
cd "$(git rev-parse --show-toplevel)"

# stdin: one "<local ref> <local sha> <remote ref> <remote sha>" line per ref being pushed.
zero="0000000000000000000000000000000000000000"
scala_pattern='\.(scala|sbt)$|^project/|^\.scalafmt\.conf$|^\.scalafix\.conf$'
frontend_pattern='^site/static/'
need_scala=0
pushing=0
frontend_bad_commits=()
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [[ "$local_sha" == "$zero" ]] && continue      # deleting a remote branch: nothing to lint
  pushing=1
  if [[ "$remote_sha" == "$zero" ]]; then
    # New branch on the remote: what's new relative to origin/main (no origin/main: lint
    # everything).
    base="$(git merge-base "$local_sha" origin/main 2>/dev/null || true)"
  else
    base="$remote_sha"
  fi
  if [[ -z "$base" ]] || ! git cat-file -e "$base^{commit}" 2>/dev/null \
     || git diff --name-only "$base" "$local_sha" | grep -qE "$scala_pattern"; then
    need_scala=1
  fi
  if [[ -z "$base" ]] || ! git cat-file -e "$base^{commit}" 2>/dev/null; then
    continue    # same invalid-base case the scala check above already tolerates
  fi
  # A commit touching site/static/** needs a `MIP: MIP-NNNN` or `MIP: none — <reason>` trailer.
  exclude=()
  if git rev-parse -q --verify origin/main >/dev/null 2>&1; then
    exclude=(--not origin/main)
  fi
  while read -r sha; do
    [[ -n "$sha" ]] || continue
    if git diff --name-only "$sha^" "$sha" 2>/dev/null | grep -qE "$frontend_pattern"; then
      msg="$(git log -1 --format=%B "$sha")"
      if ! grep -qE '^MIP: (MIP-[0-9]{4}|none — .+)$' <<<"$msg"; then
        frontend_bad_commits+=("$sha")
      fi
    fi
  done < <(git rev-list "$base..$local_sha" ${exclude[@]+"${exclude[@]}"} 2>/dev/null)
done
[[ "$pushing" == 1 ]] || exit 0

if [[ "${#frontend_bad_commits[@]}" -gt 0 ]]; then
  echo "" >&2
  echo "pre-push: commit(s) touching site/static/** with no 'MIP:' trailer — push blocked." >&2
  for sha in "${frontend_bad_commits[@]}"; do
    echo "  $(git log -1 --format='%h %s' "$sha")" >&2
  done
  echo "Add 'MIP: MIP-NNNN' (the design it's for) or 'MIP: none — <reason>' (a bug fix/typo/" >&2
  echo "refactor with no behaviour change — .claude/skills/mip/SKILL.md's 'Not for' list) to" >&2
  echo "each commit's trailers, or bypass with 'git push --no-verify' if you really need to." >&2
  exit 1
fi

if [[ -n "${IN_NIX_SHELL:-}" ]] || ! command -v nix >/dev/null 2>&1; then
  run=(just)
else
  run=(nix develop --command just)
fi

echo "pre-push: running 'just quality-other' (ruff, self-tests, actionlint, hadolint)..."
if ! "${run[@]}" quality-other; then
  echo "" >&2
  echo "pre-push: quality-other failed — push to '$remote' blocked." >&2
  echo "Fix it ('just quality-fix' for the auto-fixable part), or bypass with 'git push --no-verify' if you really need to." >&2
  exit 1
fi

if [[ "$need_scala" == 1 ]]; then
  echo "pre-push: Scala/sbt changes in the pushed commits, running 'just quality-scala' (scalafmt + scalafix)..."
  if ! "${run[@]}" quality-scala; then
    echo "" >&2
    echo "pre-push: quality-scala failed — push to '$remote' blocked." >&2
    echo "Fix it ('just quality-fix' reformats and applies scalafix), or bypass with 'git push --no-verify' if you really need to." >&2
    exit 1
  fi
else
  echo "pre-push: no Scala/sbt changes in the pushed commits, skipping quality-scala."
fi
