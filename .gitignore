# sbt / Scala
target/
project/target/
project/project/
.bloop/
.bsp/
.metals/
.ammonite/
metals.sbt

# Coursier / Ivy
.ivy2/
.coursier/

# Nix
result
result-*
.direnv/

# Azure Developer CLI
.azure/

# Env / secrets
.env
*.pem
*.key

# OS / editor
.DS_Store
.idea/
*.iml
.vscode/

# Logs
*.log

# sbt boot server socket dir (see justfile's XDG_RUNTIME_DIR override)
/.tmp/*
!/.tmp/.gitkeep

# LocalFileSightingStore's default output (sightings/) — runtime data, not a build artifact
/data/*
!/data/.gitkeep
# The OODS store is versioned data, not runtime output (MIP-0056 §5.1).
!/data/oods/
# the raw layer lives in a Hugging Face dataset (MIP-0056 §4.4 revised); the manifest indexes it
/data/oods/raw/
/finetune/data/*
!/finetune/data/.gitkeep
/finetune/out/*
!/finetune/out/.gitkeep

# repomix — `just context-*` writes under /.tmp/ (ignored above); these are repomix's own default
# output names in case it's run bare from the repo root
repomix-output.*
repomix-output/

# MIP-0005: `just site-build` output (boards + a copy of site/static/) — derived, deployed, not committed
/site/dist/*
!/site/dist/.gitkeep

# Claude Code agent worktrees (Agent tool, isolation: worktree) — ephemeral nested checkouts
.claude/worktrees/
.claude/settings.local.json

# mip-solve-perpetual's gh-unauthenticated fallback log — commands for a human to replay
# (PR creation, stack linking) when the session had no gh auth. Never committed.
/GH_POST_MORTEM.md

# Personal, machine-specific Claude Code overrides (MIP-0011 §5 item 10) — never shared behavior
# (that belongs in the committed .claude/settings.json).
/CLAUDE.local.md

# Python bytecode — regenerated by any run, and six of these were tracked by mistake:
# they conflicted on every rebase of a branch that touched a .py file.
__pycache__/
*.pyc
