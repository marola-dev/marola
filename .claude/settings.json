{
  "attribution": {
    "commit": "Co-Authored-By: Claude <noreply@anthropic.com>",
    "pr": "",
    "sessionUrl": false
  },
  "extraKnownMarketplaces": {
    "marola-devkit": {
      "source": {
        "source": "github",
        "repo": "marola-dev/marola-devkit",
        "ref": "v0.8.1"
      }
    }
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "marola-devkit@marola-devkit": true
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$(git rev-parse --show-toplevel)/.devkit/.claude/statusline.sh\""
  },
  "permissions": {
    "allow": [
      "Bash(gh auth status:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh stack:*)",
      "Bash(just uprd:*)",
      "Bash(just uprds:*)",
      "Bash(uprd:*)",
      "Bash(uprds:*)",
      "Bash(stack:*)",
      "Bash(just build*)",
      "Bash(just test*)",
      "Bash(just quality*)",
      "Bash(just fmt*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git fetch*)",
      "Bash(git rev-parse*)",
      "Bash(javap*)",
      "Bash(jar tf*)",
      "Bash(unzip -l*)",
      "Bash(command -v *)",
      "Bash(cost-split *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(gh pr merge*)",
      "Bash(gh pr close*)",
      "Bash(gh stack merge*)",
      "Bash(gh stack unstack*)",
      "Bash(gh stack delete*)"
    ]
  }
}
