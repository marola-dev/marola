{
  "attribution": {
    "commit": "Co-Authored-By: Claude <noreply@anthropic.com>",
    "pr": "",
    "sessionUrl": false
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$(git rev-parse --show-toplevel)/.claude/statusline.sh\""
  },
  "permissions": {
    "allow": [
      "Bash(gh auth status:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh stack:*)",
      "Bash(just uprd:*)",
      "Bash(just uprds:*)",
      "Bash(scripts/uprd.sh:*)",
      "Bash(scripts/uprds.sh:*)",
      "Bash(scripts/stack.sh:*)",
      "Bash(just build*)",
      "Bash(just test*)",
      "Bash(just quality*)",
      "Bash(just fmt*)",
      "Bash(sbt *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git fetch*)",
      "Bash(javap*)",
      "Bash(jar tf*)",
      "Bash(unzip -l*)",
      "Bash(command -v *)",
      "Bash(python3 scripts/cost-split.py *)"
    ],
    "deny": [
      "Bash(azd up*)",
      "Bash(azd provision*)",
      "Bash(az deployment *)",
      "Bash(az group create*)",
      "Read(.env)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(gh pr merge*)",
      "Bash(gh pr close*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-azure.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
